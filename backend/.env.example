# Environment Configuration for PG Finder Bengaluru
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=bengaluru-pg-finder-super-secret-key-change-in-prod-2026

# Database (defaults to SQLite, set to postgresql://user:pass@host:5432/dbname for PostgreSQL)
DATABASE_URL=sqlite:///pg_finder.db

# Uploads Configuration
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload

# Freshness System Config (in days)
FRESHNESS_TODAY_HOURS=24
FRESHNESS_RECENT_DAYS=7
FRESHNESS_STALE_DAYS=30

# Optional Map / External Services
MAP_DEFAULT_LAT=12.9716
MAP_DEFAULT_LNG=77.5946
MAP_DEFAULT_ZOOM=12
